{
  "name": "prensa",
  "version": "0.1.0",
  "private": true,
  "description": "Prensa — compresor PDF profesional, local-first, con Polen",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @prensa/web dev",
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ds:sync": "tsx tools/polen-sync.ts",
    "bench": "tsx tools/bench/run.ts",
    "deploy": "pnpm --filter @prensa/web deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.0"
  }
}
